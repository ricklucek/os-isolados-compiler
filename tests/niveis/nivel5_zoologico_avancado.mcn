linhaMax receba 0;
colunaMax receba 0;
j receba 0;
repete ( j receba 0 , j < 16 , j receba j + 1 ) edai
[
distanciaAtual receba distanciasLinha0{j};
cond ( distanciaAtual > maiorDistancia ) edai
[
