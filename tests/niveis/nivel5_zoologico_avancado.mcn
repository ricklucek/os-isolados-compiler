registro Cuidador @
[
palavra nome;
inteira documento;
inteira idade;
]

registro Recinto @
[
palavra nome;
inteira capacidade;
inteira ocupacaoAtual;
]

outrafuncao inteira resto(inteira a, inteira b) @
[
inteira quociente;
inteira r;
quociente receba a // b;
r receba quociente * b;
r receba a - r;
respost r;
]

outrafuncao bool validarCpf(inteira doc) @
[
inteira restoOnze;
bool valido;
restoOnze receba resto(doc, 11);
valido receba restoOnze ! 0;
respost valido;
]

outrafuncao bool ehPrimo(inteira n) @
[
bool primo;
inteira divisor;
inteira quociente;
inteira restoDivisao;
primo receba VER;
cond ( n < 2 ) edai
[
primo receba FAL;
]
divisor receba 2;
durante ( divisor < n ) edai
[
quociente receba n // divisor;
restoDivisao receba quociente * divisor;
restoDivisao receba n - restoDivisao;
cond ( restoDivisao == 0 ) edai
[
primo receba FAL;
]
divisor receba divisor + 1;
]
respost primo;
]

outrafuncao inteira fibonacci(inteira n) @
[
inteira resultado;
inteira parteUm;
inteira parteDois;
cond ( n < 2 ) edai
[
resultado receba n;
]
casocontrario edai
[
parteUm receba fibonacci(n - 1);
parteDois receba fibonacci(n - 2);
resultado receba parteUm + parteDois;
]
respost resultado;
]

outrafuncao bool verificarFaixaEtaria(inteira idade, inteira minimo, inteira maximo) @
[
bool acimaDoMinimo;
bool abaixoDoMaximo;
bool dentroDaFaixa;
bool foraDaFaixa;
acimaDoMinimo receba idade > minimo;
abaixoDoMaximo receba idade < maximo;
dentroDaFaixa receba acimaDoMinimo E abaixoDoMaximo;
foraDaFaixa receba NÃO dentroDaFaixa;
respost foraDaFaixa;
]

outrafuncao inteira maximoDoisInteiros(inteira a, inteira b) @
[
inteira maior;
cond ( a > b ) edai
[
maior receba a;
]
casocontrario edai
[
maior receba b;
]
respost maior;
]

