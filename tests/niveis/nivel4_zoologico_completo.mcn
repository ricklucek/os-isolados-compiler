distanciasLinha0{0} receba 1;
distanciasLinha0{1} receba 4;
distanciasLinha0{2} receba 7;
distanciasLinha0{3} receba 10;
distanciasLinha0{4} receba 13;
distanciasLinha0{5} receba 16;

distanciasLinha1{0} receba 4;
distanciasLinha1{1} receba 1;
distanciasLinha1{2} receba 4;
distanciasLinha1{3} receba 7;
distanciasLinha1{4} receba 10;
distanciasLinha1{5} receba 13;

distanciasLinha2{0} receba 7;
distanciasLinha2{1} receba 4;
distanciasLinha2{2} receba 1;
distanciasLinha2{3} receba 4;
distanciasLinha2{4} receba 7;
distanciasLinha2{5} receba 10;

distanciasLinha3{0} receba 10;
distanciasLinha3{1} receba 7;
distanciasLinha3{2} receba 4;
distanciasLinha3{3} receba 1;
distanciasLinha3{4} receba 4;
distanciasLinha3{5} receba 7;

distanciasLinha4{0} receba 13;
distanciasLinha4{1} receba 10;
distanciasLinha4{2} receba 7;
distanciasLinha4{3} receba 4;
distanciasLinha4{4} receba 1;
distanciasLinha4{5} receba 4;

distanciasLinha5{0} receba 16;
distanciasLinha5{1} receba 13;
distanciasLinha5{2} receba 10;
distanciasLinha5{3} receba 7;
distanciasLinha5{4} receba 4;
distanciasLinha5{5} receba 1;

repete ( i receba 0 , i < tamanho , i receba i + 1 ) edai
[
repete ( j receba 0 , j < limiteSort , j receba j + 1 ) edai
[
pesoAtual receba pesos{j};
pesoProximo receba pesos{j + 1};
cond ( pesoAtual > pesoProximo ) edai
[
tempPeso receba pesos{j};
pesos{j} receba pesos{j + 1};
pesos{j + 1} receba tempPeso;

tempNome receba nomes{j};
nomes{j} receba nomes{j + 1};
nomes{j + 1} receba tempNome;

tempIdade receba idades{j};
idades{j} receba idades{j + 1};
idades{j + 1} receba tempIdade;

tempEspecie receba especies{j};
especies{j} receba especies{j + 1};
especies{j + 1} receba tempEspecie;
]
]
]

pesoBuscado receba pesos{0};
inicio receba 0;
fim receba limiteSort;
indiceEncontrado receba 0 - 1;
durante ( fim > inicio ) edai
[
meio receba inicio + fim;
meio receba meio // 2;
pesoNoMeio receba pesos{meio};
cond ( pesoNoMeio == pesoBuscado ) edai
[
indiceEncontrado receba meio;
inicio receba fim + 1;
]
casocontrario edai
[
cond ( pesoNoMeio < pesoBuscado ) edai
[
inicio receba meio + 1;
]
casocontrario edai
[
fim receba meio - 1;
]
]
]
pesoNoMeio receba pesos{inicio};
cond ( pesoNoMeio == pesoBuscado ) edai
[
indiceEncontrado receba inicio;
]

qtdPrimos receba 0;
repete ( candidato receba 2 , candidato < 50 , candidato receba candidato + 1 ) edai
[
candidatoPrimo receba ehPrimo(candidato);
cond ( candidatoPrimo == VER ) edai
[
cond ( qtdPrimos < tamanho ) edai
[
primosEncontrados{qtdPrimos} receba candidato;
qtdPrimos receba qtdPrimos + 1;
]
]
]

qtdCpfValidos receba 0;
repete ( i receba 0 , i < qtdCuidadores , i receba i + 1 ) edai
[
docAtual receba documentos{i};
cpfAtualValido receba validarCpf(docAtual);
cond ( cpfAtualValido == VER ) edai
[
qtdCpfValidos receba qtdCpfValidos + 1;
]
]

combinacaoLogica receba verificarFaixaEtaria(idadesCuidadores{0}, 18, 60);

maiorDistancia receba 0;
linhaMax receba 0;
colunaMax receba 0;
j receba 0;
repete ( j receba 0 , j < 6 , j receba j + 1 ) edai
[
distanciaAtual receba distanciasLinha0{j};
cond ( distanciaAtual > maiorDistancia ) edai
[
maiorDistancia receba distanciaAtual;
linhaMax receba 0;
colunaMax receba j;
]
]
j receba 0;
repete ( j receba 0 , j < 6 , j receba j + 1 ) edai
[
distanciaAtual receba distanciasLinha1{j};
cond ( distanciaAtual > maiorDistancia ) edai
[
maiorDistancia receba distanciaAtual;
linhaMax receba 1;
colunaMax receba j;
]
]
j receba 0;
repete ( j receba 0 , j < 6 , j receba j + 1 ) edai
[
distanciaAtual receba distanciasLinha2{j};
cond ( distanciaAtual > maiorDistancia ) edai
[
maiorDistancia receba distanciaAtual;
linhaMax receba 2;
colunaMax receba j;
]
]
j receba 0;
repete ( j receba 0 , j < 6 , j receba j + 1 ) edai
[
distanciaAtual receba distanciasLinha3{j};
cond ( distanciaAtual > maiorDistancia ) edai
[
maiorDistancia receba distanciaAtual;
linhaMax receba 3;
colunaMax receba j;
]
]
j receba 0;
repete ( j receba 0 , j < 6 , j receba j + 1 ) edai
[
distanciaAtual receba distanciasLinha4{j};
cond ( distanciaAtual > maiorDistancia ) edai
[
maiorDistancia receba distanciaAtual;
linhaMax receba 4;
colunaMax receba j;
]
]
j receba 0;
repete ( j receba 0 , j < 6 , j receba j + 1 ) edai
[
distanciaAtual receba distanciasLinha5{j};
cond ( distanciaAtual > maiorDistancia ) edai
[
maiorDistancia receba distanciaAtual;
linhaMax receba 5;
colunaMax receba j;
]
]

somaPesos receba 0;
repete ( i receba 0 , i < tamanho , i receba i + 1 ) edai
[
somaPesos receba somaPesos + pesos{i};
]
mediaPesos receba somaPesos // tamanho;
somaComoDuplo receba somaPesos;
raizDaSoma receba raiz(somaComoDuplo);

qtdVizinhoMaisPesado receba 0;
repete ( i receba 0 , i < limiteSort , i receba i + 1 ) edai
[
pesoAtual receba pesos{i};
pesoProximo receba pesos{i + 1};
cond ( pesoProximo > pesoAtual ) edai
[
qtdVizinhoMaisPesado receba qtdVizinhoMaisPesado + 1;
]
]

fibResultado receba fibonacci(10);
potResultado receba 2 ^ 8;

alvo receba "Rajah3";
indiceEncontrado receba 0 - 1;
i receba 0;
durante ( i < tamanho ) edai
[
nomeAtual receba nomes{i};
cond ( nomeAtual == alvo ) edai
[
indiceEncontrado receba i;
i receba tamanho;
]
casocontrario edai
[
i receba i + 1;
]
]

respost mediaPesos;
]