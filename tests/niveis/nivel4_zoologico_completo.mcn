nomes{11} receba "Bubbles11";
especies{11} receba "hipopotamo";
pesos{11} receba 1400;
idades{11} receba 12;

nomesCuidadores{0} receba "Ana Paula";
documentos{0} receba 12345678901;
idadesCuidadores{0} receba 25;

nomesCuidadores{1} receba "Bruno Alves";
documentos{1} receba 98765432100;
idadesCuidadores{1} receba 26;

nomesCuidadores{2} receba "Carla Dias";
documentos{2} receba 11122233344;
idadesCuidadores{2} receba 27;

nomesCuidadores{3} receba "Diego Souza";
documentos{3} receba 55566677788;
idadesCuidadores{3} receba 28;

nomesCuidadores{4} receba "Elisa Nunes";
documentos{4} receba 22233344455;
idadesCuidadores{4} receba 29;

nomesCuidadores{5} receba "Fabio Lima";
documentos{5} receba 33344455566;
