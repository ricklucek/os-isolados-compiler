registro Cuidador @
[
palavra nome;
inteira documento;
inteira idade;
]

registro Recinto @
[
palavra nome;
inteira capacidade;
inteira ocupacaoAtual;
]

outrafuncao inteira resto(inteira a, inteira b) @
[
inteira quociente;
inteira r;
quociente receba a // b;
r receba quociente * b;
r receba a - r;
respost r;
]

outrafuncao bool validarCpf(inteira doc) @
[
inteira restoOnze;
bool valido;
restoOnze receba resto(doc, 11);
valido receba restoOnze ! 0;
respost valido;
]

outrafuncao bool ehPrimo(inteira n) @
[
bool primo;
inteira divisor;
inteira quociente;
inteira restoDivisao;
primo receba VER;
cond ( n < 2 ) edai
[
primo receba FAL;
]
divisor receba 2;
durante ( divisor < n ) edai
[
quociente receba n // divisor;
restoDivisao receba quociente * divisor;
restoDivisao receba n - restoDivisao;
cond ( restoDivisao == 0 ) edai
[
primo receba FAL;
]
divisor receba divisor + 1;
]
respost primo;
]

outrafuncao inteira fibonacci(inteira n) @
[
inteira resultado;
inteira parteUm;
inteira parteDois;
cond ( n < 2 ) edai
[
resultado receba n;
]
casocontrario edai
[
parteUm receba fibonacci(n - 1);
parteDois receba fibonacci(n - 2);
resultado receba parteUm + parteDois;
]
respost resultado;
]

outrafuncao bool verificarFaixaEtaria(inteira idade, inteira minimo, inteira maximo) @
[
bool acimaDoMinimo;
bool abaixoDoMaximo;
bool dentroDaFaixa;
bool foraDaFaixa;
acimaDoMinimo receba idade > minimo;
abaixoDoMaximo receba idade < maximo;
dentroDaFaixa receba acimaDoMinimo E abaixoDoMaximo;
foraDaFaixa receba NÃO dentroDaFaixa;
respost foraDaFaixa;
]

inteira principal() @
[
inteira i;
inteira j;
inteira k;
inteira tamanho;
inteira limiteSort;
inteira qtdCuidadores;
inteira tempPeso;
palavra tempNome;
inteira tempIdade;
palavra tempEspecie;
inteira pesoAtual;
inteira pesoProximo;
palavra nomeAtual;
palavra alvo;
inteira indiceEncontrado;
inteira inicio;
inteira fim;
inteira meio;
inteira pesoNoMeio;
inteira pesoBuscado;
bool cpfOk;
bool combinacaoLogica;
inteira somaPesos;
inteira mediaPesos;
inteira candidato;
inteira qtdPrimos;
bool candidatoPrimo;
inteira maiorDistancia;
inteira distanciaAtual;
inteira linhaMax;
inteira colunaMax;
inteira fibResultado;
inteira potResultado;
inteira qtdVizinhoMaisPesado;
inteira docAtual;
bool cpfAtualValido;
inteira qtdCpfValidos;
duplocarpado somaComoDuplo;
duplocarpado raizDaSoma;

palavra vet{12} nomes;
inteira vet{12} pesos;
inteira vet{12} idades;
palavra vet{12} especies;

palavra vet{6} nomesCuidadores;
inteira vet{6} documentos;
inteira vet{6} idadesCuidadores;

inteira vet{12} primosEncontrados;

inteira vet{6} distanciasLinha0;
inteira vet{6} distanciasLinha1;
inteira vet{6} distanciasLinha2;
inteira vet{6} distanciasLinha3;
inteira vet{6} distanciasLinha4;
inteira vet{6} distanciasLinha5;

tamanho receba 12;
limiteSort receba tamanho - 1;
qtdCuidadores receba 6;

nomes{0} receba "Simba0";
especies{0} receba "leao";
pesos{0} receba 190;
idades{0} receba 1;

nomes{1} receba "Baloo1";
especies{1} receba "urso";
pesos{1} receba 260;
idades{1} receba 2;

nomes{2} receba "Zazu2";
especies{2} receba "tucano";
pesos{2} receba 2;
idades{2} receba 3;

nomes{3} receba "Rajah3";
especies{3} receba "tigre";
pesos{3} receba 210;
idades{3} receba 4;

nomes{4} receba "Dumbo4";
especies{4} receba "elefante";
pesos{4} receba 540;
idades{4} receba 5;

