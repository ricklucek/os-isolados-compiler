inteira principal() @
[
    inteira vet{5} valores;
    inteira soma;

    valores{0} receba 1;
    valores{1} receba 2;
    valores{2} receba 3;
    valores{3} receba 4;
    valores{4} receba 5;

    soma receba valores{0} + valores{1} + valores{2} + valores{3} + valores{4};
    saida(soma);
    respost 0;
]
